{
  "kind": "collectionType",
  "collectionName": "strapi_menu_items",
  "info": {
    "singularName": "menu-item",
    "pluralName": "menu-items",
    "displayName": "Menu Item"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "image_url": {
      "type": "string"
    },
    "is_veg": {
      "type": "boolean",
      "default": false
    },
    "meal_type": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "required": true
    },
    "is_available": {
      "type": "boolean",
      "default": true
    },
    "enabled": {
      "type": "boolean",
      "required": true,
      "default": true
    }
  }
}
